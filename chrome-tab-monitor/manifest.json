{
  "manifest_version": 3,
  "name": "Tab Activity Monitor",
  "version": "1.0.0",
  "description": "Monitor active time spent on each browser tab",
  "permissions": [
    "tabs",
    "storage",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Activity Monitor"
  },
  "background": {
    "service_worker": "background.js"
  }
}
